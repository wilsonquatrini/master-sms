# ============================================================
# Master SMS Bot — Configuração
# Copie este arquivo para .env e preencha com seus dados
# ============================================================

# ---------- TELEGRAM ----------
# Token do bot (obter em @BotFather)
TELEGRAM_BOT_TOKEN=seu_token_aqui

# IDs dos administradores (separados por vírgula)
ADMIN_IDS=123456789,987654321

# ---------- SMS-ACTIVATE (ENCERRADO) ----------
# SMS-Activate encerrou operações. Use HeroSMS ou 5SIM abaixo.
# SMS_ACTIVATE_API_KEY=sua_chave_aqui
# SMS_ACTIVATE_BASE_URL=https://api.sms-activate.org/stubs/handler_api.php

# ---------- HEROSMS (sucessor SMS-Activate) ----------
# Chave da API do HeroSMS (hero-sms.com)
HEROSMS_API_KEY=sua_chave_hero_sms_aqui

# URL base da API (padrão)
# HEROSMS_BASE_URL=https://hero-sms.com/stubs/handler_api.php

# ---------- 5SIM ----------
# Chave da API do 5SIM (5sim.net) — JWT token
# FIVESIM_API_KEY=seu_token_5sim_aqui
# FIVESIM_BASE_URL=https://5sim.net/v1

# ---------- MULTI-PROVIDER ----------
# Providers ativos (separados por vírgula)
# Opções: hero_sms, five_sim
# SMS_PROVIDERS=hero_sms,five_sim

# País padrão para números (24 = Brasil)
# DEFAULT_COUNTRY=24

# ---------- BANCO DE DADOS ----------
# URL de conexão (PostgreSQL)
DATABASE_URL=postgresql://alfred:master_secret_2024@postgres:5432/alfred_sms

# Para SQLite local (não recomendado em produção):
# DATABASE_URL=sqlite:///data/master_sms.db

# ---------- PIX / MERCADO PAGO (recomendado) ----------
# Access Token do Mercado Pago (gerado em: https://www.mercadopago.com.br/settings/account/panel)
# Precisa ter permissão para criar pagamentos PIX
MERCADO_PAGO_ACCESS_TOKEN=TEST-123456789-abcdef...

# ---------- PIX / PLUGGY (fallback) ----------
# Credenciais Pluggy (para PIX automático caso não use Mercado Pago)
# Deixe vazio para usar PIX manual (chave estática)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_API_KEY=
PLUGGY_RECIPIENT_ID=
# PLUGGY_ENVIRONMENT=sandbox  # sandbox ou production

# Chave PIX manual (fallback quando Pluggy não configurado)
PIX_KEY=sua_chave_pix@exemplo.com
PIX_NAME=Master SMS
PIX_CITY=Sao Paulo

# URL do webhook (para receber confirmações de pagamento)
# WEBHOOK_URL=https://seu-dominio.com

# ---------- REFERRAL (3 NÍVEIS) ----------
# Comissão por nível (em %)
REFERRAL_LEVEL_1=10
REFERRAL_LEVEL_2=5
REFERRAL_LEVEL_3=2

# Bônus de cadastro por indicação (em R$)
REFERRAL_SIGNUP_BONUS=2.0

# ---------- MARKUP (LUCRO) ----------
# Markup global: preço_venda = custo * (1 + markup/100)
# Ex: 100 = 100% de markup (vende pelo dobro do custo)
MARKUP_GLOBAL=100

# Markups específicos por serviço (sobrescreve o global)
# Formato: "wa:150,ig:120,tg:100"
# MARKUP_BY_SERVICE=wa:150,ig:130,tg:120

# ---------- DEPÓSITOS ----------
MIN_DEPOSIT=5.0
MAX_DEPOSIT=1000.0
CHECK_PAYMENT_INTERVAL=30

# ---------- SUPORTE ----------
# Username do Telegram para suporte (ex: @meu_suporte)
# SUPPORT_USERNAME=

# ---------- GERAL ----------
DEBUG=False
CURRENCY=R$